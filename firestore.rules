rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. User Profile Document: users/{uid}
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // 2. Emergency Contacts Subcollection: users/{uid}/contacts/{contactId}
      match /contacts/{contactId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == uid);
        allow update: if isOwner(uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == uid);
        allow delete: if isOwner(uid);
      }

      // 3. Trusted Places Subcollection: users/{uid}/trusted_places/{placeId}
      match /trusted_places/{placeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == uid);
        allow update: if isOwner(uid) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == uid);
        allow delete: if isOwner(uid);
      }

      // 4. Emergency History Subcollection: users/{uid}/emergency_history/{historyId}
      match /emergency_history/{historyId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid);
        allow update: if isOwner(uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid);
        allow delete: if isOwner(uid);
      }

      // 5. Settings Preferences Subcollection: users/{uid}/settings/{settingId}
      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 6. Active Emergencies: emergencies/{emergencyId}
    match /emergencies/{emergencyId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // 7. Live Location Streaming: locations/{uid}
    match /locations/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 8. Auxiliary Application Collections
    match /alerts/{alertId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /safety_timers/{timerId} {
      allow read, write: if isAuthenticated();
    }

    match /ai_analysis/{analysisId} {
      allow read, write: if isAuthenticated();
    }

    match /ai_emergency_analysis_new/{analysisId} {
      allow read, write: if isAuthenticated();
    }

    match /fall_events/{eventId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Legacy User Data Root Collections (Deprecated in Phases 1-3)
    // Direct client access is denied to prevent cross-user data leakage.
    match /contacts/{contactId} {
      allow read, write: if false;
    }

    match /emergency_history_records/{recordId} {
      allow read, write: if false;
    }

    match /emergency_history/{historyId} {
      allow read, write: if false;
    }

    // 10. Default Deny: All other unmapped paths are closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
